lotig separation with purge_dups, and Hi-C based scaffolding with YaHS. The mitochondrial genome was assembled using MitoHiFi. Finally, the primary assembly was analysed and manually improved using rapid curation. This alternate haplotype assembly combines the haplotigs separated by purge_dups with haplotigs separated from the primary assembly during curation. Due to the repetitive nature of the sequence the order and orientation of scaffolds in the following regions are unsure: Chromosome 1\n14.10-29.54Mb, Chromosome 2\n19.21-24.26Mb, Chromosome 3\n18.39-26.05, Chromosome 4\n16.28-26.44Mb, Chromosome 5\n17.23-24.40Mb, Chromosome 6\n9.90-22.38Mb, Chromosome 7\n16.55-33.23Mb, Chromosome 8\n17.79-35.15Mb, Chromosome 9\n16.21-27.67Mb, Chromosome 10\n12.84-24.02Mb, Chromosome 11\n8.29-18.51Mb, Chromosome 12\n11.79-15.64Mb.","linkedAssemblies":[{"linkedAssembly":"GCA_947310635.1","assemblyType":"principal_pseudohaplotype_of_diploid"}],"assemblyStatus":"current","diploidRole":"alternate_pseudohaplotype_of_diploid","bioprojectAccession":"PRJEB57371","assemblyMethod":"various","releaseDate":"2022-11-27"},"assemblyStats":{"totalSequenceLength":"434099467","totalUngappedLength":"434099467","numberOfContigs":1130,"contigN50":1232347,"contigL50":98,"numberOfScaffolds":1130,"scaffoldN50":1232347,"scaffoldL50":98,"numberOfComponentSequences":1130,"gcCount":"138347990","gcPercent":32,"genomeCoverage":"47","atgcCount":"434099467"},"wgsInfo":{"wgsProjectAccession":"CAMZJM01","masterWgsUrl":"https://www.ncbi.nlm.nih.gov/nuccore/CAMZJM000000000.1","wgsContigsUrl":"https://www.ncbi.nlm.nih.gov/Traces/wgs/CAMZJM01"},"currentAccession":"GCA_947310685.1","accession":"GCA_947310685.1","sourceDatabase":"SOURCE_DATABASE_GENBANK","organism":{"taxId":2996356,"organismName":"Leptodirus hochenwartii"}}
